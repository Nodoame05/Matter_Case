// 最小攻撃集合（IPK ともう 1 つだけ）で性質が破れるトレース。TIMEOUT の all-traces lemma の反例に使う
lemma attack_R_I_by_IPK_peerNOsK:
  exists-trace
  "Ex rNid iNid fid iEphpK rEphpK sk #i #k1 #k2.
     Commit_R(rNid, iNid, fid, iEphpK, rEphpK, sk) @ #i
     & not (Ex #j. Running_I(iNid, rNid, fid, iEphpK, rEphpK, sk) @ #j)
     & Leak_IPK(fid) @ #k1
     & Leak_NOsK(iNid) @ #k2 & #k2 < #i
     & not (Ex #l. Leak_NOsK(rNid) @ #l)
     & not (Ex p #l. Leak_Eph(p) @ #l)
     & not (Ex a b c #l. Eph_I(a, b, c) @ #l)"

lemma attack_R_I_by_IPK_iEph:
  exists-trace
  "Ex rNid iNid fid iEphpK rEphpK sk #i #k1 #k2.
     Commit_R(rNid, iNid, fid, iEphpK, rEphpK, sk) @ #i
     & not (Ex #j. Running_I(iNid, rNid, fid, iEphpK, rEphpK, sk) @ #j)
     & Leak_IPK(fid) @ #k1
     & Leak_Eph(iEphpK) @ #k2
     & not (Ex n #l. Leak_NOsK(n) @ #l)
     & not (Ex #l. Leak_Eph(rEphpK) @ #l)"

lemma attack_R_I_by_IPK_rEph:
  exists-trace
  "Ex rNid iNid fid iEphpK rEphpK sk #i #k1 #k2.
     Commit_R(rNid, iNid, fid, iEphpK, rEphpK, sk) @ #i
     & not (Ex #j. Running_I(iNid, rNid, fid, iEphpK, rEphpK, sk) @ #j)
     & Leak_IPK(fid) @ #k1
     & Leak_Eph(rEphpK) @ #k2
     & not (Ex n #l. Leak_NOsK(n) @ #l)
     & not (Ex #l. Leak_Eph(iEphpK) @ #l)"

end
